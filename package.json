    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tool-calling",
    "mcp",
    "guardrails",
    "security",
    "human-in-the-loop"
  ],
  "author": "Cyril Delage",
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.22.0",
    "ai": "^7.0.173",
    "zod": "^4.6.7"
  }
}
